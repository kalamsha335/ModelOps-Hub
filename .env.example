# ==========================================
# ModelOps Hub - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ModelOps Hub
API_V1_STR=/api/v1
SECRET_KEY=change_me_to_a_secure_random_key_in_production

# Database Configuration (PostgreSQL with automatic SQLite fallback)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=modelops_db
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/modelops_db
SQLITE_FALLBACK_URL=sqlite:///./modelops.db

# MLflow Tracking & Registry
# Local SQLite backend is used by default for zero-dependency standalone execution
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=credit-card-fraud-detection
MLFLOW_MODEL_NAME=fraud-detection-model

# Statistical Data Drift Monitoring Thresholds
# Operational thresholds for Population Stability Index (PSI) and Kolmogorov-Smirnov (KS) test
DRIFT_PSI_WARNING_THRESHOLD=0.20
DRIFT_PSI_CRITICAL_THRESHOLD=0.30
DRIFT_KS_PVALUE_THRESHOLD=0.05
DRIFT_SHARE_DRIFTED_THRESHOLD=0.25

# Automated Retraining & Anti-Regression Guardrails
RETRAINING_MIN_PR_AUC_THRESHOLD=0.80
RETRAINING_MIN_RECALL_THRESHOLD=0.75
MAX_RETRAINING_COOLDOWN_HOURS=24

# Prefect Workflow Orchestration
PREFECT_API_URL=http://localhost:4200/api

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173
