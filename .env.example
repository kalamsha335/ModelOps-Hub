# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ModelOps Hub
API_V1_STR=/api/v1
SECRET_KEY=change_me_to_a_secure_random_key_in_production

# Database Configuration (PostgreSQL with SQLite fallback)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=modelops_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modelops_db
SQLITE_FALLBACK_URL=sqlite:///./modelops.db

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-card-fraud-detection
MLFLOW_MODEL_NAME=fraud-detection-model

# Evidently & Drift Monitoring Thresholds
DRIFT_PSI_WARNING_THRESHOLD=0.20
DRIFT_PSI_CRITICAL_THRESHOLD=0.30
DRIFT_KS_PVALUE_THRESHOLD=0.05
DRIFT_SHARE_DRIFTED_THRESHOLD=0.25

# Retraining Guardrails
RETRAINING_MIN_PR_AUC_THRESHOLD=0.80
RETRAINING_MIN_RECALL_THRESHOLD=0.82
MAX_RETRAINING_COOLDOWN_HOURS=24

# Prefect Orchestration
PREFECT_API_URL=http://localhost:4200/api

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

